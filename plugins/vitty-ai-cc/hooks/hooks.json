{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "mcp_tool", "server": "plugin:vitty-ai-cc:vitty", "tool": "start",
          "input": { "message": "${prompt}", "session_id": "${session_id}", "folder": "${cwd}", "client": "claude-code" } } ] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__.*vitty.*__delegate",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-file.mjs\"" } ] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [ { "type": "mcp_tool", "server": "plugin:vitty-ai-cc:vitty", "tool": "start",
          "input": { "event": "compact", "session_id": "${session_id}", "folder": "${cwd}", "client": "claude-code" } } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "mcp_tool", "server": "plugin:vitty-ai-cc:vitty", "tool": "stop",
          "input": { "message": "${last_assistant_message}", "session_id": "${session_id}", "client": "claude-code" } } ] }
    ]
  }
}
