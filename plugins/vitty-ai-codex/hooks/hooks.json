{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "mcp_tool", "server": "vitty", "tool": "start",
          "input": { "message": "${prompt}", "session_id": "${session_id}", "folder": "${cwd}", "client": "codex" } } ] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__.*vitty.*__(retrieve|collaborate|delegate|calibrate|submit_validation_result)",
        "hooks": [ { "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/before-tool.mjs\"" } ] },
      { "matcher": "^(Bash|apply_patch|mcp__.*)$",
        "hooks": [ { "type": "mcp_tool", "server": "vitty", "tool": "before_tool", "timeout": 30,
          "input": { "session_id": "${session_id}", "tool_name": "${tool_name}", "tool_input": "${tool_input}" } } ] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [ { "type": "mcp_tool", "server": "vitty", "tool": "start",
          "input": { "event": "compact", "session_id": "${session_id}", "folder": "${cwd}", "client": "codex" } } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "mcp_tool", "server": "vitty", "tool": "stop",
          "input": { "message": "${last_assistant_message}", "session_id": "${session_id}", "client": "codex" } } ] }
    ]
  }
}
